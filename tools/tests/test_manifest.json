{
  "schemaVersion": 3,
  "description": "按功能域选测，规则见 docs/RELEASE_CHECKLIST.md 的验证入口；paths 支持 * 和目录前缀，related 声明跨域消费者，gate: fast 为 Fast 基础集（缺省 full）。keep 仅标注领域（data 数据安全 / main 日常主路径 / boundary 保护边界 / compat 生态兼容），不构成测试准入条件。",
  "profiles": {
    "node-parallel": {
      "environment": "node",
      "timeoutMs": 30000,
      "parallel": true
    },
    "node-serial": {
      "environment": "node",
      "timeoutMs": 60000,
      "parallel": false
    },
    "browser": {
      "environment": "browser",
      "timeoutMs": 120000,
      "parallel": true
    }
  },
  "probes": {
    "android-smoke": {
      "entry": "tools/probes/run_android_emulator_smoke.ps1",
      "when": "Worker、CSP、原生桥、文件系统或 Android 生命周期在 WebView 上的行为",
      "domains": ["platform"],
      "paths": [
        "app/src/main/assets/index.html",
        "app/src/main/assets/js/workers/",
        "app/src/main/assets/js/app/47-script-worker.js",
        "app/src/main/assets/js/app/52-mvu-body.js",
        "app/src/main/assets/js/core/risu-lua.js",
        "app/src/main/assets/js/core/risu-regex-runtime.js",
        "app/src/main/assets/js/app/30-card-import.js",
        "app/src/main/assets/js/app/64-stream-drafts.js",
        "app/src/main/assets/js/app/92-theme-ui.js",
        "app/src/main/assets/js/app/95-chat-io-mobile.js"
      ]
    },
    "real-card": {
      "entry": "tools/probes/card_package_browser_acceptance.js",
      "when": "按发布清单「真实卡选测」选择具备相应能力的原卡验证",
      "domains": ["import", "risu", "scripts"]
    }
  },
  "sharedPaths": [
    "app/src/main/assets/js/app/00-*",
    "app/src/main/assets/js/app/05-*",
    "app/src/main/assets/js/app/99-*",
    "app/src/main/assets/js/core/pure.js",
    "tools/tests/source.js",
    "app/src/main/assets/index.html",
    "app/src/main/assets/js/vendor/*",
    "tools/tests/run_all.js"
  ],
